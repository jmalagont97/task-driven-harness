// ==============================================================================
// EXAMPLE SCHEMA: Conversational Flow Graph Specification
// This file serves as a reference template for designing workflow graphs in the harness.
// ==============================================================================
{
  "$schema_description": "Conversational Flow Graph Specification for the Task-Driven ML Harness",
  "header": {
    "flow_id": "flow_ml_tabular_iterative_v1",
    "name": "Iterative Tabular Machine Learning Flow with Optimization Loop",
    "version": "1.0.0",
    "author": "Task-Driven Harness Architecture",
    "description": "Conversational and control graph designed to solve tabular ML problems. Starts with exploratory data analysis (EDA), transitions to an iterative and bidirectional cycle between Feature Engineering and Modeling/Validation, and concludes at a Consolidator Agent that evaluates results and issues the final decision.",
    "graph_properties": {
      "is_cyclic": true,
      "supports_bidirectional_dialogue": true,
      "loop_prevention_mechanism": "Hierarchical 3-level control: (1) global turn limit for the entire run, (2) max visits limit per individual node, and (3) max iterations limit per cycle with continuation condition and forced fallback target to the consolidator.",
      "blackboard_integration": "Each agent reads accumulated state from blackboard.md and commits contributions to its assigned section. Conditional transitions evaluate variables and metrics reflected on the blackboard."
    }
  },

  "global_guards": {
    "global_max_turns": 15,
    "execution_timeout_seconds": 600,
    "on_global_limit_action": "force_transition_to_terminal_node"
  },

  "entry_node": "eda_agent",
  "terminal_node": "consolidator_agent",

  "nodes": {
    "eda_agent": {
      "agent_declaration": "declarations/agents/eda_agent.json",
      "role": "Data Auditor & Exploratory Analyst",
      "description": "Inspects dataset, detects column data types, outliers, missing values, and class imbalance.",
      "max_visits": 2,
      "blackboard_permissions": {
        "read_sections": ["problem_spec"],
        "write_section": "eda_insights"
      }
    },
    "feature_agent": {
      "agent_declaration": "declarations/agents/feature_agent.json",
      "role": "Feature Engineering Specialist",
      "description": "Designs, generates, and selects predictive features based on EDA findings or modeler feedback.",
      "max_visits": 5,
      "blackboard_permissions": {
        "read_sections": ["problem_spec", "eda_insights", "experiment_leaderboard"],
        "write_section": "feature_engineering"
      }
    },
    "model_agent": {
      "agent_declaration": "declarations/agents/model_agent.json",
      "role": "Model Explorer & Validation Specialist",
      "description": "Trains baseline and candidate models, evaluates cross-validation metrics, and reports performance and overfitting risks.",
      "max_visits": 5,
      "blackboard_permissions": {
        "read_sections": ["problem_spec", "eda_insights", "feature_engineering", "experiment_leaderboard"],
        "write_section": "experiment_leaderboard"
      }
    },
    "consolidator_agent": {
      "agent_declaration": "declarations/agents/consolidator_agent.json",
      "role": "Lead Data Scientist & Decision Arbiter",
      "description": "Terminal node. Reads all cumulative evidence from the blackboard, screens for data leakage/overfitting, and produces the final reproducible pipeline.",
      "max_visits": 1,
      "blackboard_permissions": {
        "read_sections": ["*"],
        "write_section": "final_decision"
      }
    }
  },

  "edges": [
    {
      "edge_id": "edge_eda_to_features",
      "from": "eda_agent",
      "to": "feature_agent",
      "bidirectional": false,
      "description": "Initial transition: once data audit is completed, hand off insights to the feature engineer.",
      "transition_condition": "blackboard.has_section('eda_insights') == true"
    },
    {
      "edge_id": "edge_features_models_cycle",
      "from": "feature_agent",
      "to": "model_agent",
      "bidirectional": true,
      "description": "Bidirectional collaborative dialogue channel. Feature Agent proposes variables and Model Agent validates them. If overfitting or improvement room is detected, control returns to Feature Agent.",
      "loop_controls": {
        "max_cycle_iterations": 3,
        "continue_condition": "agent_feedback.requires_more_features == true AND cycle_count < max_cycle_iterations",
        "exit_condition": "agent_feedback.converged == true OR metric_delta < 0.002",
        "fallback_target": "consolidator_agent"
      }
    },
    {
      "edge_id": "edge_model_to_consolidator",
      "from": "model_agent",
      "to": "consolidator_agent",
      "bidirectional": false,
      "description": "Final transition to consolidator when modeler achieves convergence or experiment budget exhausts.",
      "transition_condition": "cycle_completed('edge_features_models_cycle') == true OR agent_feedback.status == 'ready_for_consolidation'"
    }
  ]
}
