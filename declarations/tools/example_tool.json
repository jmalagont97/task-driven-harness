// ==============================================================================
// EXAMPLE SCHEMA: Tool Declaration for Task-Driven ML Harness
// This file serves as a reference template for declaring tools.
// Based on tool.template.json.
// ==============================================================================
{
  "schema_version": "1.0.0",
  "id": "execute_python",
  "name": "execute_python_code",
  "kind": "tool",
  "version": "0.1.0",
  "description": "Executes a Python script in an isolated local environment with time and memory constraints, capturing stdout, stderr, exit code, and generated artifacts.",
  "prompt_context": "execute_python_code: Executes Python code to inspect data, engineer features, or train machine learning models. Use when computing real operations with libraries such as pandas, numpy, scikit-learn, or lightgbm. Returns stdout, stderr, exit code, and generated artifacts. Do not run interactive commands with input() or unauthorized network requests.",

  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code"],
    "properties": {
      "code": {
        "type": "string",
        "description": "Self-contained executable Python script to run in the sandbox."
      },
      "timeout_s": {
        "type": ["integer", "null"],
        "description": "Execution timeout limit in seconds; if null, defaults to configured system value (120s)."
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["ok", "tool_id", "version"],
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "Indicates whether the script completed with exit code 0 without unhandled exceptions."
      },
      "tool_id": {
        "type": "string",
        "description": "Identifier of the tool that produced this response."
      },
      "version": {
        "type": "string",
        "description": "Version of the executed tool."
      },
      "result": {
        "type": "object",
        "description": "Response payload upon successful execution.",
        "properties": {
          "stdout": {
            "type": "string",
            "description": "Captured standard output from the script."
          },
          "stderr": {
            "type": "string",
            "description": "Captured standard error or warning output."
          },
          "exit_code": {
            "type": "integer",
            "description": "Process termination exit code (0 indicates success)."
          },
          "execution_time_s": {
            "type": "number",
            "description": "Real elapsed execution time in seconds."
          },
          "artifacts_created": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of new or updated file paths in artifacts/."
          }
        }
      },
      "flags": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Semantic flags emitted during execution (e.g., ['high_memory_usage'])."
      },
      "warnings": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Non-fatal warnings produced by the environment or libraries."
      },
      "error": {
        "type": "object",
        "description": "Error details if ok is false; allows the LLM to self-debug its code.",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["input_error", "timeout_error", "dependency_error", "runtime_error", "memory_limit_exceeded"]
          },
          "message": {
            "type": "string",
            "description": "Full traceback or detailed exception message."
          }
        }
      },
      "disclaimer": {
        "type": ["string", "null"]
      }
    }
  },

  "config": {
    "default_timeout_s": 120,
    "max_memory_mb": 4096,
    "working_directory": "artifacts/",
    "max_output_chars": 10000
  },

  "examples": [
    {
      "input": {
        "code": "import pandas as pd\ndf = pd.read_csv('train.csv')\nprint(f'Shape: {df.shape}')"
      },
      "expected_flags": []
    }
  ],

  "deterministic": false,
  "side_effects": "write",
  "disclaimer": "Code executes in a local subprocess within the harness virtual environment.",
  "references": [
    "code/tools/execute_python.py"
  ]
}
