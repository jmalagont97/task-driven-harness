{
  "schema_version": "1.0.0",
  "id": "abalone_age_shell_weight_lookup",
  "name": "abalone_age_shell_weight_lookup",
  "kind": "tool",
  "version": "0.1.0",
  "description": "Estimates the abalone ring count from an empirical table of training specimens with the same sex and shell-weight decile (median and P10-P90).",
  "prompt_context": "abalone_age_shell_weight_lookup: Empirical expert for the ring count (age in years = rings + 1.5) of 1-50 abalone specimens. It finds the training specimens of the same sex in the same shell_weight decile and returns their median ring count, their P10-P90 range (an empirical 80% interval) and the cell size n. 'sparse_cell' means fewer than config.min_cell_n training specimens back the answer; 'empty_cell_fallback' means the cell was empty and all sexes were used. Sex may be M, F, I or 'unknown'. Send all 8 fields in dataset units (mm or g divided by 200), although only shell_weight and sex are used. On hold-out data it keeps the most predictions within 2 rings of the four age tools, but it is weak on rare old specimens. Read-only.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "specimens"
    ],
    "properties": {
      "specimens": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "description": "Specimens to age (1-50). Every value is in dataset units: the original millimetres or grams divided by 200.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "diameter",
            "height",
            "whole_weight",
            "shucked_weight",
            "viscera_weight",
            "shell_weight",
            "sex"
          ],
          "properties": {
            "length": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.0,
              "description": "Longest shell measurement in mm/200, e.g. 0.475 (= 95 mm)."
            },
            "diameter": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.0,
              "description": "Shell diameter perpendicular to length, in mm/200."
            },
            "height": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.5,
              "description": "Height with meat in shell, in mm/200. Must be greater than 0."
            },
            "whole_weight": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 4.0,
              "description": "Whole abalone weight in g/200."
            },
            "shucked_weight": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 2.0,
              "description": "Meat weight in g/200."
            },
            "viscera_weight": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.0,
              "description": "Gut weight after bleeding, in g/200."
            },
            "shell_weight": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.5,
              "description": "Dried shell weight in g/200."
            },
            "sex": {
              "type": "string",
              "enum": [
                "M",
                "F",
                "I",
                "unknown"
              ],
              "description": "Sex: M (male), F (female), I (infant) or 'unknown' (uses parameters estimated on all sexes)."
            }
          }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "tool_id",
      "version"
    ],
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "True when every specimen was scored; false with 'error' otherwise."
      },
      "tool_id": {
        "type": "string",
        "description": "Identifier of the tool that produced this response."
      },
      "version": {
        "type": "string",
        "description": "Version of the tool."
      },
      "result": {
        "type": "object",
        "required": [
          "predictions",
          "model_card"
        ],
        "properties": {
          "predictions": {
            "type": "array",
            "description": "One entry per input specimen, in input order.",
            "items": {
              "type": "object",
              "required": [
                "index",
                "predicted_rings",
                "predicted_age_years",
                "interval_80",
                "age_group",
                "cell",
                "flags"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "description": "Position in the input specimens list."
                },
                "predicted_rings": {
                  "type": "number"
                },
                "predicted_age_years": {
                  "type": "number",
                  "description": "predicted_rings + 1.5."
                },
                "interval_80": {
                  "type": "object",
                  "required": [
                    "low",
                    "high",
                    "method"
                  ],
                  "properties": {
                    "low": {
                      "type": "number"
                    },
                    "high": {
                      "type": "number"
                    },
                    "method": {
                      "type": "string"
                    }
                  },
                  "description": "80% interval for the ring count; the low end is never below 1."
                },
                "age_group": {
                  "type": "string",
                  "enum": [
                    "Young (1-7)",
                    "Young Adult (8-10)",
                    "Adult (11-15)",
                    "Old (16+)"
                  ]
                },
                "cell": {
                  "type": "object",
                  "required": [
                    "sex_group",
                    "bin",
                    "shell_weight_range",
                    "n"
                  ],
                  "properties": {
                    "sex_group": {
                      "type": "string"
                    },
                    "bin": {
                      "type": "integer",
                      "description": "Decile bin, 0 = lightest."
                    },
                    "shell_weight_range": {
                      "type": "array",
                      "items": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "description": "[low, high]; high is null for the last bin."
                    },
                    "n": {
                      "type": "integer",
                      "description": "Training specimens in the cell."
                    }
                  }
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "tail_region",
                      "sex_unknown",
                      "sparse_cell",
                      "empty_cell_fallback",
                      "out_of_distribution",
                      "inconsistent_weights"
                    ]
                  },
                  "description": "tail_region: prediction above config.tail_rings_above rings, where data are scarce. out_of_distribution: some value lies outside P0.5-P99.5 of the training data. inconsistent_weights: shucked + viscera + shell > 1.1 x whole. sex_unknown: sex was 'unknown', so all sexes were pooled. sparse_cell: fewer than config.min_cell_n training specimens in the cell. empty_cell_fallback: the sex-specific cell was empty, so all sexes were used."
                }
              }
            }
          },
          "model_card": {
            "type": "object",
            "required": [
              "algorithm",
              "trained_on",
              "edges",
              "min_cell_n",
              "sparse_cells",
              "holdout_metrics"
            ],
            "properties": {
              "algorithm": {
                "type": "string"
              },
              "trained_on": {
                "type": "string"
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Internal decile edges of shell_weight on the train split."
              },
              "min_cell_n": {
                "type": "integer"
              },
              "sparse_cells": {
                "type": "integer",
                "description": "Sex-specific cells with fewer than min_cell_n specimens."
              },
              "holdout_metrics": {
                "type": "object",
                "required": [
                  "mae",
                  "rmse",
                  "r2",
                  "within_2_rings",
                  "interval_coverage"
                ],
                "description": "Metrics on the frozen test split (835 specimens), computed once at training time.",
                "properties": {
                  "mae": {
                    "type": "number",
                    "description": "Mean absolute error in rings."
                  },
                  "rmse": {
                    "type": "number"
                  },
                  "r2": {
                    "type": "number"
                  },
                  "within_2_rings": {
                    "type": "number",
                    "description": "Share of test specimens predicted within 2 rings."
                  },
                  "interval_coverage": {
                    "type": "number",
                    "description": "Share of test specimens inside their 80% interval."
                  },
                  "interval_mean_width": {
                    "type": "number"
                  },
                  "median_baseline_mae": {
                    "type": "number",
                    "description": "MAE of always answering the training median."
                  },
                  "mae_by_age_group": {
                    "type": "object",
                    "description": "MAE by true age group.",
                    "additionalProperties": {
                      "type": "number"
                    }
                  },
                  "n_test": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "flags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Every per-specimen flag plus tool-level flags, sorted."
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Caveats to carry into the agent's summary."
      },
      "error": {
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "description": "Present when ok is false.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "input_error",
              "artifact_missing",
              "runtime_error"
            ]
          },
          "message": {
            "type": "string",
            "description": "What went wrong and how to fix the call."
          }
        }
      },
      "disclaimer": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "config": {
    "params_path": "artifacts/models/abalone/expert_params.json",
    "metrics_path": "artifacts/models/abalone/metrics.json",
    "max_specimens": 50,
    "tail_rings_above": 15,
    "min_cell_n": 15,
    "default_timeout_s": 5
  },
  "examples": [
    {
      "input": {
        "specimens": [
          {
            "length": 0.475,
            "diameter": 0.365,
            "height": 0.13,
            "whole_weight": 0.4805,
            "shucked_weight": 0.1905,
            "viscera_weight": 0.114,
            "shell_weight": 0.1475,
            "sex": "F"
          }
        ]
      },
      "expected_flags": []
    }
  ],
  "deterministic": true,
  "side_effects": "read",
  "disclaimer": "Empirical summary of similar training specimens (same sex, same shell-weight decile); age in years is about rings + 1.5.",
  "references": [
    "code/tools/abalone/age_experts.py",
    "code/tools/abalone/train_abalone_tools.py",
    "code/tools/abalone/README.md"
  ],
  "mcp": {
    "expose": true,
    "server": "abalone_tools",
    "title": "Abalone age - Shell-weight lookup (expert)",
    "entrypoint": "code/tools/abalone/age_experts.py::predict_shell_weight_lookup",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
}
