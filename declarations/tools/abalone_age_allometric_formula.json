{
  "schema_version": "1.0.0",
  "id": "abalone_age_allometric_formula",
  "name": "abalone_age_allometric_formula",
  "kind": "tool",
  "version": "0.1.0",
  "description": "Estimates the abalone ring count with the allometric formula rings = a * shell_weight^b fitted per sex, with an 80% lognormal interval.",
  "prompt_context": "abalone_age_allometric_formula: Biological rule of thumb for the ring count (age in years = rings + 1.5) of 1-50 abalone specimens: rings = a * shell_weight^b, with a and b fitted per sex on a log-log scale. Returns the prediction, an 80% interval from the lognormal residual spread, and the formula with the numbers substituted so you can quote it. Sex may be M, F, I or 'unknown' (coefficients fitted on all sexes, flag 'sex_unknown'). Send all 8 fields in dataset units (mm or g divided by 200), although only shell_weight and sex are used. Hold-out MAE about 1.75 rings; the curve flattens for very old specimens. Read-only.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "specimens"
    ],
    "properties": {
      "specimens": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "description": "Specimens to age (1-50). Every value is in dataset units: the original millimetres or grams divided by 200.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "diameter",
            "height",
            "whole_weight",
            "shucked_weight",
            "viscera_weight",
            "shell_weight",
            "sex"
          ],
          "properties": {
            "length": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.0,
              "description": "Longest shell measurement in mm/200, e.g. 0.475 (= 95 mm)."
            },
            "diameter": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.0,
              "description": "Shell diameter perpendicular to length, in mm/200."
            },
            "height": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.5,
              "description": "Height with meat in shell, in mm/200. Must be greater than 0."
            },
            "whole_weight": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 4.0,
              "description": "Whole abalone weight in g/200."
            },
            "shucked_weight": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 2.0,
              "description": "Meat weight in g/200."
            },
            "viscera_weight": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.0,
              "description": "Gut weight after bleeding, in g/200."
            },
            "shell_weight": {
              "type": "number",
              "minimum": 0.0005,
              "maximum": 1.5,
              "description": "Dried shell weight in g/200."
            },
            "sex": {
              "type": "string",
              "enum": [
                "M",
                "F",
                "I",
                "unknown"
              ],
              "description": "Sex: M (male), F (female), I (infant) or 'unknown' (uses parameters estimated on all sexes)."
            }
          }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "tool_id",
      "version"
    ],
    "properties": {
      "ok": {
        "type": "boolean",
        "description": "True when every specimen was scored; false with 'error' otherwise."
      },
      "tool_id": {
        "type": "string",
        "description": "Identifier of the tool that produced this response."
      },
      "version": {
        "type": "string",
        "description": "Version of the tool."
      },
      "result": {
        "type": "object",
        "required": [
          "predictions",
          "model_card"
        ],
        "properties": {
          "predictions": {
            "type": "array",
            "description": "One entry per input specimen, in input order.",
            "items": {
              "type": "object",
              "required": [
                "index",
                "predicted_rings",
                "predicted_age_years",
                "interval_80",
                "age_group",
                "formula",
                "coefficients",
                "flags"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "description": "Position in the input specimens list."
                },
                "predicted_rings": {
                  "type": "number"
                },
                "predicted_age_years": {
                  "type": "number",
                  "description": "predicted_rings + 1.5."
                },
                "interval_80": {
                  "type": "object",
                  "required": [
                    "low",
                    "high",
                    "method"
                  ],
                  "properties": {
                    "low": {
                      "type": "number"
                    },
                    "high": {
                      "type": "number"
                    },
                    "method": {
                      "type": "string"
                    }
                  },
                  "description": "80% interval for the ring count; the low end is never below 1."
                },
                "age_group": {
                  "type": "string",
                  "enum": [
                    "Young (1-7)",
                    "Young Adult (8-10)",
                    "Adult (11-15)",
                    "Old (16+)"
                  ]
                },
                "formula": {
                  "type": "string",
                  "description": "The formula with this specimen's numbers substituted."
                },
                "coefficients": {
                  "type": "object",
                  "required": [
                    "group",
                    "a",
                    "b",
                    "sigma_log"
                  ],
                  "properties": {
                    "group": {
                      "type": "string"
                    },
                    "a": {
                      "type": "number"
                    },
                    "b": {
                      "type": "number"
                    },
                    "sigma_log": {
                      "type": "number"
                    }
                  }
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "tail_region",
                      "sex_unknown",
                      "out_of_distribution",
                      "inconsistent_weights"
                    ]
                  },
                  "description": "tail_region: prediction above config.tail_rings_above rings, where data are scarce. out_of_distribution: some value lies outside P0.5-P99.5 of the training data. inconsistent_weights: shucked + viscera + shell > 1.1 x whole. sex_unknown: sex was 'unknown', so coefficients fitted on all sexes were used."
                }
              }
            }
          },
          "model_card": {
            "type": "object",
            "required": [
              "algorithm",
              "trained_on",
              "coefficients",
              "interval",
              "holdout_metrics"
            ],
            "properties": {
              "algorithm": {
                "type": "string"
              },
              "trained_on": {
                "type": "string"
              },
              "coefficients": {
                "type": "object",
                "description": "a, b, sigma_log and n for M, F, I and unknown (all sexes)."
              },
              "interval": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "level": {
                    "type": "number"
                  }
                }
              },
              "holdout_metrics": {
                "type": "object",
                "required": [
                  "mae",
                  "rmse",
                  "r2",
                  "within_2_rings",
                  "interval_coverage"
                ],
                "description": "Metrics on the frozen test split (835 specimens), computed once at training time.",
                "properties": {
                  "mae": {
                    "type": "number",
                    "description": "Mean absolute error in rings."
                  },
                  "rmse": {
                    "type": "number"
                  },
                  "r2": {
                    "type": "number"
                  },
                  "within_2_rings": {
                    "type": "number",
                    "description": "Share of test specimens predicted within 2 rings."
                  },
                  "interval_coverage": {
                    "type": "number",
                    "description": "Share of test specimens inside their 80% interval."
                  },
                  "interval_mean_width": {
                    "type": "number"
                  },
                  "median_baseline_mae": {
                    "type": "number",
                    "description": "MAE of always answering the training median."
                  },
                  "mae_by_age_group": {
                    "type": "object",
                    "description": "MAE by true age group.",
                    "additionalProperties": {
                      "type": "number"
                    }
                  },
                  "n_test": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "flags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Every per-specimen flag plus tool-level flags, sorted."
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Caveats to carry into the agent's summary."
      },
      "error": {
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "description": "Present when ok is false.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "input_error",
              "artifact_missing",
              "runtime_error"
            ]
          },
          "message": {
            "type": "string",
            "description": "What went wrong and how to fix the call."
          }
        }
      },
      "disclaimer": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "config": {
    "params_path": "artifacts/models/abalone/expert_params.json",
    "metrics_path": "artifacts/models/abalone/metrics.json",
    "max_specimens": 50,
    "tail_rings_above": 15,
    "default_timeout_s": 5
  },
  "examples": [
    {
      "input": {
        "specimens": [
          {
            "length": 0.475,
            "diameter": 0.365,
            "height": 0.13,
            "whole_weight": 0.4805,
            "shucked_weight": 0.1905,
            "viscera_weight": 0.114,
            "shell_weight": 0.1475,
            "sex": "F"
          }
        ]
      },
      "expected_flags": []
    }
  ],
  "deterministic": true,
  "side_effects": "read",
  "disclaimer": "Allometric rule of thumb based on dried shell weight and sex only; age in years is about rings + 1.5.",
  "references": [
    "code/tools/abalone/age_experts.py",
    "code/tools/abalone/train_abalone_tools.py",
    "code/tools/abalone/README.md"
  ],
  "mcp": {
    "expose": true,
    "server": "abalone_tools",
    "title": "Abalone age - Allometric formula (expert)",
    "entrypoint": "code/tools/abalone/age_experts.py::predict_allometric_formula",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
}
