// ==============================================================================
// EXAMPLE SCHEMA: Agent Declaration for Task-Driven ML Harness
// This file serves as a reference template for declaring agents.
// Note: The internal delegation block has been removed; graph flow governs transitions.
// ==============================================================================
{
  "schema_version": "1.0.0",
  "id": "eda_agent",
  "name": "Data Auditor & Exploratory Analysis Specialist",
  "version": "0.1.0",
  "description": "Specialist in data quality auditing, missing value detection, class distribution, correlations, and data leakage prevention.",
  "enabled": true,

  "role": {
    "type": "specialist",
    "permissions": {
      "can_receive_tasks": true,
      "can_use_tools": true,
      "can_use_expert_tools": false,
      "can_use_rag": false,
      "can_use_data_knowledge": false,
      "can_write_external": false,
      "can_finish_task": true
    },
    "reports_to": "consolidator_agent"
  },

  "prompt": {
    "template_format": "mustache",
    "template": "# ROLE\n{{role}}\n\n# CORE MISSION\n{{task}}\n\n# PROBLEM CONTEXT (BLACKBOARD)\n{{inputs}}\n\n# NON-NEGOTIABLE RULES\n{{rules}}\n\n# ASSIGNED TOOLS\n{{tools}}\n\n# REQUIRED OUTPUT FORMAT\n{{output_format}}",
    "role": "You are a senior data scientist specializing in Exploratory Data Analysis (EDA) and rigorous data quality auditing for Machine Learning.",
    "task": "Empirically inspect the dataset specified in the blackboard. Analyze dimensions, column types, missing values, cardinality, potential data leakage, and target variable distribution. Produce a structured report and recommend an appropriate validation strategy.",
    "rules": [
      "Execute real Python code via 'execute_python' to inspect data properties; never assume, guess, or hallucinate values.",
      "Identify non-predictive columns (IDs, constant timestamps, or columns with >90% missing values) and recommend them for exclusion.",
      "Examine target distribution in detail to flag class imbalance or target skewness where applicable.",
      "Always provide a clean, structured Markdown summary in 'markdown_summary' ready to be stamped into blackboard.md.",
      "Respond strictly using the JSON format defined in output_format."
    ],
    "inputs": [
      {
        "name": "problem_spec",
        "type": "string",
        "required": true,
        "description": "Content of the problem_spec section of blackboard.md (data paths, target, metric, constraints)."
      }
    ],
    "tools": {
      "render": "auto_from_bindings",
      "description": "Sandbox tools for dataset inspection and computation.",
      "usage_policy": [
        "Use execute_python to extract summary statistics (shape, dtypes, missing values, target value_counts).",
        "Do not spawn interactive GUI windows (e.g., plt.show()); print numerical metrics and descriptive tables instead.",
        "If a script fails with a traceback, analyze the error, fix the arguments/code, and retry once."
      ]
    },
    "output_format": {
      "type": "json",
      "schema": {
        "type": "object",
        "required": ["status", "result", "warnings"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["completed", "partial", "failed"]
          },
          "result": {
            "type": "object",
            "required": [
              "dataset_shape",
              "target_distribution",
              "missing_values_summary",
              "columns_to_drop",
              "recommended_validation_split",
              "markdown_summary"
            ],
            "properties": {
              "dataset_shape": { "type": "string", "description": "Dataset dimensions (e.g., 10000 rows, 14 columns)" },
              "target_distribution": { "type": "string", "description": "Class breakdown or continuous target statistics" },
              "missing_values_summary": { "type": "array", "items": { "type": "string" }, "description": "List of columns with missing values and percentages" },
              "columns_to_drop": { "type": "array", "items": { "type": "string" }, "description": "Candidate columns to drop due to low quality or leakage" },
              "recommended_validation_split": { "type": "string", "description": "Recommended validation strategy (e.g., StratifiedKFold 5 splits)" },
              "markdown_summary": { "type": "string", "description": "Markdown text to be inserted by runtime into blackboard.md under eda_insights" }
            }
          },
          "missing_data": {
            "type": "array",
            "items": { "type": "string" }
          },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },

  "tools": [
    {
      "tool_id": "execute_python",
      "enabled": true,
      "access": "python",
      "usage_hint": "Use this tool to run pandas, numpy, and scipy scripts to audit the dataset on disk.",
      "requires_approval": false,
      "max_calls_per_task": 5,
      "timeout_s": 60
    }
  ],

  "expert_tools": [],

  "knowledge": {
    "rag": { "enabled": false },
    "data_knowledge": { "enabled": false }
  },

  "model": {
    "provider": "google_genai",
    "deployment": "remote",
    "model_name": "gemini-2.5-pro",
    "connection": {
      "base_url": null,
      "api_key_env": "GEMINI_API_KEY",
      "timeout_s": 120,
      "max_retries": 2,
      "headers": {},
      "proxy_env": null
    },
    "parameters": {
      "temperature": 0.1,
      "top_p": null,
      "max_tokens": 4096,
      "stop": [],
      "seed": 42
    },
    "capabilities": {
      "tool_calling": true,
      "structured_output": true,
      "streaming": true,
      "vision": false
    },
    "billing": {
      "paid": false,
      "currency": "USD"
    },
    "fallback": []
  },

  "memory": {
    "short_term": {
      "enabled": true,
      "backend": "memory",
      "path": null,
      "max_messages": 20
    },
    "long_term": {
      "enabled": false
    }
  },

  "guardrails": {
    "disclaimer": null,
    "sensitive_data": {
      "redact_in_logs": true,
      "allowed_identifiers": []
    },
    "human_in_the_loop": {
      "enabled": false
    },
    "forbidden_actions": [
      "Delete or overwrite raw dataset files on disk",
      "Attempt unauthorized external network requests"
    ],
    "output_validation": {
      "enforce_schema": true,
      "on_failure": "retry",
      "max_retries": 2
    }
  },

  "runtime": {
    "max_iterations": 6,
    "timeout_s": 240,
    "parallel_tool_calls": false,
    "streaming": true,
    "adapters": {}
  },

  "observability": {
    "log_level": "INFO",
    "tracing": {
      "enabled": false,
      "provider": "none"
    }
  },

  "metadata": {
    "owner": "Task-Driven Harness",
    "created_at": "2026-10-15",
    "updated_at": "2026-10-15",
    "tags": ["eda", "tabular_ml", "specialist", "quality_audit"]
  }
}
